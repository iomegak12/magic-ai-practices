# ── Server ──────────────────────────────────────────
SERVER_NAME=orders-complaints-mcp-server
SERVER_HOST=0.0.0.0
SERVER_PORT=8700

# ── Database ────────────────────────────────────────
DB_NAME=orders_complaints.db

# ── Seeding ─────────────────────────────────────────
SEED_ON_STARTUP=true

# ── Rate Limiting (per-client IP) ───────────────────
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=50
RATE_LIMIT_WINDOW_SECONDS=60
