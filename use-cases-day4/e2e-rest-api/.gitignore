# Environment
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data / DB
data/
*.db
*.sqlite3

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Coverage / Testing
.coverage
htmlcov/
.pytest_cache/
