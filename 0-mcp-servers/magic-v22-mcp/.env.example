# Environment configuration — copy to .env and fill in values

# API Key Authentication
API_KEY=change-me-to-a-strong-random-secret-at-least-32-chars
# Set to false for local Claude Desktop connections (avoids mcp-remote OAuth discovery)
REQUIRE_AUTH=true

# Server
MCP_HOST=0.0.0.0
MCP_PORT=9898

# Database
DB_PATH=./data/magic_v22.db

# Logging
LOG_LEVEL=INFO
